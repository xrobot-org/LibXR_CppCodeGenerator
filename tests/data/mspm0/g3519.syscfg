/**
 * Write custom configuration values to the imported modules.
 */
const divider1       = system.clockTree["PLL_CLK2X_DIV"];
divider1.divideValue = 4;

const divider2       = system.clockTree["PLL_CLK1_DIV"];
divider2.divideValue = 2;

const divider3       = system.clockTree["PLL_PDIV"];
divider3.divideValue = 2;

const divider4       = system.clockTree["UDIV"];
divider4.divideValue = 2;

const gate1  = system.clockTree["MFPCLKGATE"];
gate1.enable = true;

const multiplier1         = system.clockTree["PLL_QDIV"];
multiplier1.multiplyValue = 20;

const mux0       = system.clockTree["CANCLKMUX"];
mux0.inputSelect = "CANCLKMUX_PLLCLK1_OUT";

const mux1       = system.clockTree["EXHFMUX"];
mux1.inputSelect = "EXHFMUX_XTAL";

const mux2       = system.clockTree["SYSPLLMUX"];
mux2.inputSelect = "zSYSPLLMUX_HFCLK";

const mux3       = system.clockTree["HSCLKMUX"];
mux3.inputSelect = "HSCLKMUX_SYSPLL2X";

const mux4       = system.clockTree["EXLFMUX"];
mux4.inputSelect = "EXLFMUX_XTAL";

const mux5       = system.clockTree["LFXTMUX"];
mux5.inputSelect = "LFXTMUX_TRUE";

const pinFunction1                        = system.clockTree["HFXT"];
pinFunction1.enable                       = true;
pinFunction1.inputFreq                    = 16;
pinFunction1.HFXTStartup                  = 255;
pinFunction1.HFCLKMonitor                 = true;
pinFunction1.peripheral.hfxInPin.$assign  = "PA5";
pinFunction1.peripheral.hfxOutPin.$assign = "PA6";

const pinFunction2                        = system.clockTree["LFXT"];
pinFunction2.enable                       = true;
pinFunction2.inputFreq                    = 32.768;
pinFunction2.peripheral.lfxInPin.$assign  = "PA3";
pinFunction2.peripheral.lfxOutPin.$assign = "PA4";

ADC121.$name                      = "ADC12_0";
ADC121.adcMem0chansel             = "DL_ADC12_INPUT_CHAN_3";
ADC121.peripheral.$assign         = "ADC0";
ADC121.peripheral.adcPin3.$assign = "PA24";

ADC122.$name                      = "ADC12_1";
